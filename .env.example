# Postgres connection string (Neon via Vercel Marketplace, or local Postgres)
DATABASE_URL=postgres://localhost:5432/retailer_onboarding_dev
# Public base URL used in sign-in links (omit to derive from the request)
APP_URL=http://localhost:3000
# Only this email can open /admin
ADMIN_EMAIL=you@example.com
# Resend: without a key, sign-in links are printed to the server console in dev
RESEND_API_KEY=
EMAIL_FROM=Start Your Store <login@your-verified-domain.com>
# Cloudflare Turnstile: optional in dev, required in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
